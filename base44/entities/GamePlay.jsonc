{
  "name": "GamePlay",
  "type": "object",
  "properties": {
    "gameName": {
      "type": "string",
      "description": "Slug of the played game."
    },
    "userId": {
      "type": "string",
      "description": "App user who played it. One record per user per game."
    }
  },
  "required": [
    "gameName",
    "userId"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}