{
  "name": "PromoCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Promo code (uppercased). What users type to redeem."
    },
    "aiModel": {
      "type": "string",
      "enum": [
        "ai",
        "aiCode",
        "galaxy5",
        "space5"
      ],
      "default": "ai",
      "description": "Which AI model the granted credits apply to."
    },
    "credits": {
      "type": "number",
      "default": 10,
      "description": "Number of credits granted on redemption."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive/expired codes cannot be redeemed. Set to false automatically after the single redemption."
    },
    "label": {
      "type": "string",
      "default": "",
      "description": "Optional admin note."
    }
  },
  "required": [
    "code",
    "aiModel",
    "credits"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}