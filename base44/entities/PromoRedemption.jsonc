{
  "name": "PromoRedemption",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Promo code that was redeemed."
    },
    "userId": {
      "type": "string",
      "description": "App user who redeemed the code."
    },
    "userEmail": {
      "type": "string"
    },
    "redeemedAt": {
      "type": "string",
      "format": "date-time"
    },
    "aiModel": {
      "type": "string",
      "enum": [
        "ai",
        "aiCode",
        "galaxy5",
        "space5"
      ],
      "description": "AI model the credits were granted for."
    },
    "credits": {
      "type": "number",
      "description": "Credits granted by this redemption."
    }
  },
  "required": [
    "code",
    "userId",
    "redeemedAt",
    "aiModel",
    "credits"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}