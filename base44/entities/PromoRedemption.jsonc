{
  "name": "PromoRedemption",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Promo code that was redeemed."
    },
    "userId": {
      "type": "string",
      "description": "App user who redeemed the code."
    },
    "userEmail": {
      "type": "string"
    },
    "redeemedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the granted Pro access expires."
    }
  },
  "required": [
    "code",
    "userId",
    "redeemedAt"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}