{
  "name": "PublishedSite",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique site slug (lowercase letters and hyphens). Used in the /site/:name URL."
    },
    "html": {
      "type": "string",
      "description": "Full self-contained HTML document of the published website."
    },
    "ownerName": {
      "type": "string",
      "default": "",
      "description": "Email or display name of the site owner."
    }
  },
  "required": [
    "name",
    "html"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}