{
  "name": "Team",
  "type": "object",
  "properties": {
    "ownerId": {
      "type": "string",
      "description": "App user id of the team owner (the purchaser of the Team plan)."
    },
    "memberEmails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Up to 3 invited member emails (lowercased). Members share the team's AI-code credits.",
      "default": []
    },
    "aiCodeUsed": {
      "type": "number",
      "default": 0,
      "description": "Shared AI-code credit counter for the whole team (owner + members)."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "ownerId",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.ownerId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}