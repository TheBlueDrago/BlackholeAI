{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "description": "Subscription plan granted by the payments webhook or a promo code",
      "enum": [
        "free",
        "pro",
        "team",
        "secret"
      ],
      "default": "free"
    },
    "planExpiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "When a promo-granted Pro/Team plan expires. Null for a paid subscription, the free plan, or the forever Secret plan."
    },
    "banned": {
      "type": "boolean",
      "default": false,
      "description": "True when an admin has permanently banned this user from the app."
    },
    "blockedUntil": {
      "type": "string",
      "format": "date-time",
      "description": "When a temporary admin block expires. Null when the user is not blocked."
    },
    "blockReason": {
      "type": "string",
      "description": "Optional reason recorded by the admin when banning or blocking a user."
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}