{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_payout_summary",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyPayoutEmail",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Email payout summary",
            "description": "Last 24h site sales"
          }
        }
      }
    ]
  },
  "name": "Daily Payout Summary",
  "description": "Emails a daily noreply summary of new site-sale payouts to admins.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}